# The watcher runs from cron, never over HTTP. Deny everything here; the
# script also refuses to run outside the command line in case this file is
# ignored by the server.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
